# ============================================
# VARIABLES DE ENTORNO - PetyZoos Veterinaria
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo y renombralo a ".env"
# 2. Cambia TODOS los valores por los reales de produccion
# 3. NUNCA subas el archivo .env a Git
# ============================================

# === BASE DE DATOS ===
DB_ROOT_PASSWORD=CAMBIA_ESTO_PASSWORD_ROOT_SEGURO
DB_USERNAME=petyzoos_user
DB_PASSWORD=CAMBIA_ESTO_PASSWORD_DB_SEGURO

# === SPRING BOOT ===
SPRING_PROFILE=prod
DDL_AUTO=update

# === JWT (genera un string aleatorio de 64+ caracteres) ===
JWT_SECRET=GENERA_UN_SECRET_ALEATORIO_DE_64_CARACTERES_O_MAS_AQUI_CAMBIAME
JWT_EXPIRATION=86400000

# === EMAIL SMTP ===
MAIL_USERNAME=clinicaveterinariapetyzoos@gmail.com
MAIL_PASSWORD=TU_APP_PASSWORD_DE_GMAIL_AQUI

# === CORS (separar multiples origenes con coma) ===
CORS_ORIGINS=https://tu-dominio.com,http://localhost:4200
